{
    "name": "traderapp-serverless-platform",
    "description": "traderapp-serverless-platform",
    "version": "0.0.1",
    "private": true,
    "scripts": {
        "compile": "npx tsc && node esbuild.config.js",
        "build:prep": "npm run clean && npm run compile && sam build --use-container",
        "build": "npm run build:prep --force",
        "clean": "rm -rf ./dist",
        "test": "NODE_OPTIONS=--max-old-space-size=8192 jest --passWithNoTests --runInBand",
        "test:watch": "jest --watch",
        "format:write": "prettier --write .",
        "deploy": "sam deploy",
        "deploy-function": "ts-node -r tsconfig-paths/register src/scripts/deploy-function.ts",
        "sample-local-invoke": "sam local invoke <handler-name-on-template.yml> -e events/<even-name>.json",
        "deploy-secrets": "npx ts-node src/config/secrets/deploy-secrets.ts",
        "get-users-trading-accounts": "npx ts-node -r tsconfig-paths/register src/scripts/get-users-trading-accounts.ts"
    },
    "dependencies": {
        "@aws-sdk/client-secrets-manager": "^3.675.0",
        "@aws-sdk/client-sqs": "^3.675.0",
        "@dazn/lambda-powertools-logger": "^1.28.1",
        "axios": "^1.8.4",
        "binance-api-node": "^0.12.9",
        "crypto-js": "^4.2.0",
        "date-fns": "^4.1.0",
        "dotenv": "^16.5.0",
        "js-yaml": "^4.1.0",
        "mongoose": "^8.10.0",
        "sendpulse-api": "^1.1.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.12.0",
        "@types/archiver": "^7.0.0",
        "@types/aws-lambda": "^8.10.145",
        "@types/crypto-js": "^4.2.2",
        "@types/dotenv": "^8.2.3",
        "@types/jest": "^29.5.13",
        "@types/js-yaml": "^4.0.9",
        "@types/mongoose": "^5.11.97",
        "@types/node": "^22.7.7",
        "@typescript-eslint/eslint-plugin": "^8.46.2",
        "@typescript-eslint/parser": "^8.46.2",
        "archiver": "^7.0.1",
        "esbuild": "^0.24.0",
        "esbuild-plugin-alias": "^0.2.1",
        "eslint": "^9.12.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-config-standard-with-typescript": "^43.0.1",
        "eslint-plugin-prettier": "^5.2.1",
        "globals": "^15.11.0",
        "husky": "^9.1.6",
        "jest": "^29.7.0",
        "mongodb-memory-server": "^10.1.4",
        "prettier": "^3.3.3",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.6.3",
        "typescript-eslint": "^8.9.0"
    },
    "npmOptions": {
        "legacy-peer-deps": true
    }
}
