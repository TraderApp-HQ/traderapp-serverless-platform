<mjml>
    <mj-head>
        <mj-title>TraderApp - New Trade Notification</mj-title>
        <mj-preview
            >Your A new trade has been initiated successfully.</mj-preview
        >
        <mj-attributes>
            <mj-all font-family="IBM Plex Sans, Arial, sans-serif" />
            <mj-section padding="20px 0" />
            <mj-text font-size="14px" line-height="1.4" color="#454648" />
            <mj-image padding="0" align="center" />
        </mj-attributes>
        <mj-style inline="inline">
            /* Global span styling */
            span {
                font-family: Manrope, Arial, sans-serif;
                font-weight: 400;
                font-size: 14px;
                line-height: 1.6;
                color: #0a0d14;
            }

            .highlight {
                font-weight: 700;
                color: #414141;
            }

            .name-text {
                font-family: Manrope;
                font-weight: 700;
                font-size: 18px;
                line-height: 130%;
                color: #08123b;
            }

            .deposit_details {
                font-family: Manrope;
                font-weight: 700;
                font-size: 16px;
                line-height: 150%;
                color: #0a0d14;
                margin-bottom: 6px;
            }

            .remark {
                font-family: Manrope;
                font-weight: 400;
                font-size: 16px;
                line-height: 135%;
                color: #414141;
            }

            .remarkspan {
                font-family: Manrope;
                font-weight: 600;
                font-size: 18px;
                line-height: 135%;
            }

            .details-box {
                background-color: #f5f8ff;
                border-radius: 8px;
                width: auto;
                box-sizing: border-box;
                padding: 5px 15px;
            }

            .social-box {
                background-color: #f5f8ff;
                width: auto;
                padding: 20px;
                box-sizing: border-box;
                border-radius: 8px;
            }

            .banner-img {
                width: 300px;
                height: 200px;
                angle: 0deg;
                opacity: 1;
                border-radius: 14.18px;
            }

            a {
                color: #1836b2;
                text-decoration: none;
            }

            @media only screen and (max-width: 480px) {
                .name-text,
                .remark,
                .deposit_details,
                .content {
                    text-align: center !important;
                }
            }
        </mj-style>
    </mj-head>
    <mj-body background-color="#FFFFFF">
        <mj-wrapper css-class="wrapper">
            <!-- Logo -->
            <mj-section padding-bottom="10px">
                <mj-column>
                    <mj-image
                        width="150px"
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/traderapp-logo.png"
                        alt="TraderApp Logo"
                    />
                </mj-column>
            </mj-section>

            <!-- Banner -->
            <mj-section padding-bottom="20px">
                <mj-column>
                    <mj-image
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/banners+(2).png"
                        alt="Deposit Confirmation Banner"
                    />
                </mj-column>
            </mj-section>

            <!-- Greeting -->
            <mj-section padding="0">
                <mj-column>
                    <mj-text css-class="name-text" padding="0 0 8px 0">
                        Hello {USER_NAME},
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Main Message -->
            <mj-section padding="0 0 16px 0">
                <mj-column>
                    <mj-text class="content" padding="0">
                        A new trade has just been copied to your {PLATFORM_NAME}
                        account. Below are the trade details for your reference.
                        <br /><br />
                        Please note that the trade has only been initiated and
                        not active yet. We will notify you once the order has
                        been filled and trade is active.
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Deposit Details -->
            <mj-section css-class="details-box" padding="12px 0">
                <mj-column>
                    <mj-text
                        class="deposit_details"
                        padding="0 0 6px 0"
                        font-weight="bold"
                        font-size="16px"
                    >
                        Trade Summary
                    </mj-text>

                    <!-- Bulletproof line spacing for all platforms -->
                    <mj-text
                        class="details-box"
                        padding="0"
                        font-size="14px"
                        line-height="1.6"
                        style="
                            line-height: 1.6;
                            font-family: Manrope, Arial, sans-serif;
                            color: #0a0d14;
                        "
                    >
                        <p style="margin: 0; line-height: 2">
                            <b>Asset:</b>
                            <span
                                style="
                                    display: inline-flex;
                                    align-items: center;
                                    vertical-align: middle;
                                "
                            >
                                <img
                                    src="{BASE_ASSET_LOGO_URL}"
                                    alt=""
                                    width="20"
                                    height="20"
                                    style="
                                        margin: 0 6px;
                                        vertical-align: middle;
                                    "
                                />
                                <span style="vertical-align: middle"
                                    >{BASE_ASSET}</span
                                >
                                <span
                                    style="
                                        color: red;
                                        margin-left: 6px;
                                        vertical-align: middle;
                                    "
                                    >{TRADE_SIDE}</span
                                >
                            </span>
                        </p>

                        <p style="margin: 0; line-height: 2; display: block">
                            <b>Entry Price:</b> {ENTRY_PRICE}
                        </p>
                        <p style="margin: 0; line-height: 2; display: block">
                            <b>Stop Loss Price:</b> {STOP_LOSS}
                        </p>
                        <p style="margin: 0; line-height: 2; display: block">
                            <b>Estimated Loss:</b>
                            <span style="color: red">
                                {ESTIMATED_LOSS} USDT</span
                            >
                        </p>
                        <p style="margin: 0; line-height: 2; display: block">
                            <b>Estimated Profit:</b>
                            <span style="color: green">
                                {ESTIMATED_PROFIT} USDT</span
                            >
                        </p>
                        <p style="margin: 0; line-height: 2; display: block">
                            <b>Date:</b> {DATE_TIME}
                        </p>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Support Message -->
            <mj-section padding="16px 0">
                <mj-column>
                    <mj-text class="content" padding="0">
                        Thanks for choosing TraderApp let’s make every trade
                        count!
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Closing -->
            <mj-section padding="0 0 16px 0">
                <mj-column>
                    <mj-text class="remark" padding="0">
                        Warm regards,<br />
                        <span class="remarkspan">The TraderApp Team</span>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Social Links -->
            <mj-section css-class="social-box" padding="20px 0">
                <mj-column>
                    <mj-social
                        align="center"
                        mode="horizontal"
                        icon-size="32px"
                        padding="0"
                    >
                        <mj-social-element
                            href="https://x.com/traderapp"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/twitter22.png"
                            alt="Twitter"
                        />
                        <mj-social-element
                            href="https://www.facebook.com/traderappofficial?mibextid=ZbWKwL"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/facebook22.png"
                            alt="Facebook"
                        />
                        <mj-social-element
                            href="https://instagram.com/traderapphq"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/ig22.png"
                            alt="Instagram"
                        />
                        <mj-social-element
                            href="https://traderapp.finance/#"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/tiktok22.png"
                            alt="TikTok"
                        />
                    </mj-social>
                </mj-column>
            </mj-section>
        </mj-wrapper>
    </mj-body>
</mjml>
