<mjml>
    <mj-head>
        <mj-title>TraderApp - Deposit Confirmation</mj-title>
        <mj-preview>Your deposit has been credited successfully.</mj-preview>
        <mj-style>
            .br_20 {
                border: 1px solid #d1d7f0;
                border-radius: 10px !important;
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#ffffff">
        <!-- Spacer -->
        <mj-section padding="20px 0"></mj-section>

        <!-- Main Wrapper -->
        <mj-wrapper css-class="br_20" padding="20px">
            <mj-section>
                <mj-column>
                    <!-- Logo -->
                    <mj-image
                        width="150px"
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/traderapp-logo.png"
                        alt="TraderApp Logo"
                    />

                    <!-- Optional Banner -->
                    <mj-image
                        width="100%"
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/banner.png"
                        alt="TraderApp Deposit Confirmation Banner"
                    />

                    <!-- Greeting -->
                    <mj-text
                        font-size="16px"
                        font-weight="300"
                        line-height="1.5"
                    >
                        Hi <b>Samuel</b>,
                    </mj-text>

                    <!-- Main Message -->
                    <mj-text
                        font-size="16px"
                        font-weight="200"
                        line-height="1.6"
                    >
                        Your account has been credited successfully. You have
                        deposited
                        <span style="color: #1836b2; font-weight: 600"
                            >₦44,850.00</span
                        >
                        into your TraderApp account 🎉. You’re on your way to
                        financial freedom.
                    </mj-text>

                    <!-- Transaction Details -->
                    <mj-section background-color="#F5F8FF" border-radius="8px">
                        <mj-column>
                            <mj-text
                                font-size="16px"
                                font-weight="400"
                                line-height="1.8"
                            >
                                <b>Funding Details</b><br />
                                Amount Deposited: ₦44,850.00<br />
                                Date: 27 June 2025, 08:51 AM<br />
                                Transaction ID:
                                000003241027210007003490085682<br />
                                Payment Method: Bank Transfer
                            </mj-text>
                        </mj-column>
                    </mj-section>

                    <!-- CTA -->
                    <mj-section>
                        <mj-column>
                            <mj-button
                                background-color="#1836B2"
                                border-radius="6px"
                                href="https://traderapp.finance"
                            >
                                View Dashboard
                            </mj-button>
                        </mj-column>
                    </mj-section>

                    <!-- Support -->
                    <mj-text
                        font-size="16px"
                        font-weight="200"
                        line-height="1.6"
                    >
                        If you didn’t initiate this deposit or notice any issue,
                        please contact our support team immediately at
                        <a
                            href="mailto:support@traderapp.com"
                            style="color: #1836b2; text-decoration: none"
                            >support@traderapp.com</a
                        >.
                    </mj-text>

                    <!-- Closing -->
                    <mj-text
                        font-size="16px"
                        font-weight="300"
                        line-height="1.6"
                    >
                        Warm Regards,<br />
                        <b>The TraderApp Team</b>
                    </mj-text>

                    <!-- Social Links -->
                    <mj-spacer height="20px" />
                    <mj-social
                        icon-size="25px"
                        mode="horizontal"
                        align="center"
                        icon-color="#F5F8FF"
                    >
                        <mj-social-element
                            href="https://x.com/traderapp"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/twitter22.png"
                        />
                        <mj-social-element
                            href="https://www.facebook.com/traderappofficial?mibextid=ZbWKwL"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/facebook22.png"
                        />
                        <mj-social-element
                            href="https://instagram.com/traderapphq"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/ig22.png"
                        />
                        <mj-social-element
                            href="https://traderapp.finance/#"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/tiktok22.png"
                        />
                    </mj-social>
                </mj-column>
            </mj-section>
        </mj-wrapper>
    </mj-body>
</mjml>
