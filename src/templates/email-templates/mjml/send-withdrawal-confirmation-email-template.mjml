<mjml>
    <mj-head>
        <mj-title>TraderApp - Withdrawal Successful</mj-title>
        <mj-preview
            >Your withdrawal has been processed successfully.</mj-preview
        >

        <mj-attributes>
            <mj-all font-family="IBM Plex Sans, Arial, sans-serif" />
            <mj-section padding="20px 0" />
            <mj-text font-size="14px" line-height="1.6" color="#454648" />
            <mj-image padding="0" align="center" />
        </mj-attributes>

        <mj-style inline="inline">
            .highlight {
                font-weight: 700;
                color: #414141;
            }
            .name-text {
                font-family: Manrope;
                font-weight: 700;
                font-size: 18px;
                line-height: 150%;
                color: #08123b;
            }
            .deposit_details {
                font-family: Manrope;
                font-weight: 700;
                font-size: 16px;
                line-height: 114%;
                color: #0a0d14;
                margin-bottom: 8px;
            }
            .remark {
                font-family: Manrope;
                font-weight: 400;
                font-size: 16px;
                line-height: 150%;
                color: #414141;
            }
            .remarkspan {
                font-family: Manrope;
                font-weight: 600;
                font-size: 18px;
                line-height: 150%;
            }
            .details-box {
                background-color: #f5f8ff;
                border-radius: 8px;
                width: 90%;
                box-sizing: border-box;
            }
            .social-box {
                background-color: #f5f8ff;
                width: 90%;
                padding: 20px;
                box-sizing: border-box;
            }
            .banner-img {
                width: 562;
                height: 272;
                angle: 0 deg;
                opacity: 1;
                border-radius: 24px;
            }
            a {
                color: #1836b2;
                text-decoration: none;
            }

            @media only screen and (max-width: 480px) {
                .name-text,
                .remark,
                .deposit_details,
                .content {
                    text-align: center !important;
                }
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#ffffff">
        <mj-wrapper css-class="wrapper" padding="0 16px">
            <!-- Logo -->
            <mj-section padding-bottom="10px">
                <mj-column>
                    <mj-image
                        width="150px"
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/traderapp-logo.png"
                        alt="TraderApp Logo"
                    />
                </mj-column>
            </mj-section>

            <!-- Banner -->
            <mj-section padding-bottom="20px">
                <mj-column>
                    <mj-image
                        css-class="banner-img"
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/withdrawal+banners+(2).png"
                        alt="Deposit Confirmation Banner"
                    />
                </mj-column>
            </mj-section>

            <!-- Greeting -->
            <mj-section padding="0">
                <mj-column>
                    <mj-text css-class="name-text">Hello {USER_NAME},</mj-text>
                </mj-column>
            </mj-section>

            <!-- Main Message -->
            <mj-section padding="0 0 20px 0">
                <mj-column>
                    <mj-text class="content">
                        We are pleased to inform you that your withdrawal
                        request has been successfully processed from your
                        TraderApp account.
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Deposit Details -->
            <mj-section css-class="details-box">
                <mj-column>
                    <mj-text class="deposit_details"
                        >Withdrawal Details</mj-text
                    >
                    <mj-text class="details-box">
                        <b>Amount:</b> <span>{AMOUNT} USDT</span><br />
                        <b>Date:</b> {DATE_TIME}<br />
                        <b>Wallet Address:</b> <span>{ADDRESS}</span><br />
                        <b>Network Type:</b> <span>{NETWORK}</span><br />
                        <b>Transaction ID:</b> <span>{TRANSACTION_ID}</span>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Support Message -->
            <mj-section padding="20px 0">
                <mj-column>
                    <mj-text class="content">
                        Your funds should arrive within a few minutes. You may
                        track the status of your transaction anytime from your
                        TraderApp dashboard.
                        <br /><br />
                        If you didn’t initiate this deposit or notice any issue,
                        please contact our support team immediately at
                        <a href="mailto:support@traderapp.com"
                            >support@traderapp.com</a
                        >. <br /><br />
                        Thank you for trading with TraderApp. We remain
                        committed to helping you achieve your financial goals.
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Closing -->
            <mj-section padding="0 0 20px 0">
                <mj-column>
                    <mj-text class="remark">
                        Warm regards,<br />
                        <span class="remarkspan">The TraderApp Team</span>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!--Fixed Social Links -->
            <mj-section css-class="social-box" padding="20px 0">
                <mj-column>
                    <mj-social
                        align="center"
                        mode="horizontal"
                        icon-size="32px"
                        padding="0"
                    >
                        <mj-social-element
                            href="https://x.com/traderapp"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/twitter22.png"
                            alt="Twitter"
                        />
                        <mj-social-element
                            href="https://www.facebook.com/traderappofficial?mibextid=ZbWKwL"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/facebook22.png"
                            alt="Facebook"
                        />
                        <mj-social-element
                            href="https://instagram.com/traderapphq"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/ig22.png"
                            alt="Instagram"
                        />
                        <mj-social-element
                            href="https://traderapp.finance/#"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/tiktok22.png"
                            alt="TikTok"
                        />
                    </mj-social>
                </mj-column>
            </mj-section>
        </mj-wrapper>
    </mj-body>
</mjml>
