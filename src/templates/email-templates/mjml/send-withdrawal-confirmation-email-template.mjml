<mjml>
    <mj-head>
        <mj-title>TraderApp - Withdrawal Successful</mj-title>
        <mj-preview
            >Your withdrawal has been processed successfully.</mj-preview
        >

        <mj-attributes>
            <mj-all font-family="IBM Plex Sans, Arial, sans-serif" />
            <mj-section padding="20px 0" />
            <mj-text font-size="14px" line-height="1.6" color="#0A0D14" />
            <mj-image padding="0" align="center" />
        </mj-attributes>

        <mj-style inline="inline">
            /* Global Span Styling */
            span {
                font-family: Manrope, Arial, sans-serif;
                font-weight: 400;
                font-size: 14px;
                line-height: 1.6;
                color: #0a0d14;
            }

            .highlight {
                font-weight: 700;
                color: #414141;
            }

            .name-text {
                font-family: Manrope;
                font-weight: 700;
                font-size: 18px;
                line-height: 130%;
                color: #08123b;
            }

            .section-title {
                font-family: Manrope;
                font-weight: 700;
                font-size: 16px;
                line-height: 150%;
                color: #0a0d14;
                margin-bottom: 6px;
            }

            .remark {
                font-family: Manrope;
                font-weight: 400;
                font-size: 16px;
                line-height: 135%;
                color: #414141;
            }

            .remarkspan {
                font-family: Manrope;
                font-weight: 600;
                font-size: 18px;
                line-height: 135%;
            }

            .details-box {
                background-color: #f5f8ff;
                border-radius: 8px;
                padding: 5px 15px;
                box-sizing: border-box;
            }

            .social-box {
                background-color: #f5f8ff;
                border-radius: 8px;
                padding: 20px;
                box-sizing: border-box;
            }

            .banner-img {
                width: 300px;
                height: 200px;
                border-radius: 14.18px;
            }

            a {
                color: #1836b2;
                text-decoration: none;
            }

            @media only screen and (max-width: 480px) {
                .name-text,
                .remark,
                .section-title,
                .content {
                    text-align: center !important;
                }
            }
        </mj-style>
    </mj-head>

    <mj-body background-color="#FFFFFF">
        <mj-wrapper>
            <!-- Logo -->
            <mj-section padding-bottom="10px">
                <mj-column>
                    <mj-image
                        width="150px"
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/traderapp-logo.png"
                        alt="TraderApp Logo"
                    />
                </mj-column>
            </mj-section>

            <!-- Banner -->
            <mj-section padding-bottom="20px">
                <mj-column>
                    <mj-image
                        css-class="banner-img"
                        src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/withdrawal+banners+(2).png"
                        alt="Withdrawal Confirmation Banner"
                    />
                </mj-column>
            </mj-section>

            <!-- Greeting -->
            <mj-section padding="0">
                <mj-column>
                    <mj-text css-class="name-text" padding="0 0 8px 0">
                        Hello {USER_NAME},
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Main Message -->
            <mj-section padding="0 0 16px 0">
                <mj-column>
                    <mj-text css-class="content" padding="0">
                        We are pleased to inform you that your withdrawal
                        request has been successfully processed from your
                        TraderApp account.
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Withdrawal Details -->
            <mj-section padding="12px 0">
                <mj-column css-class="details-box">
                    <mj-text css-class="section-title" padding="0 0 6px 0">
                        Withdrawal Details
                    </mj-text>

                    <mj-text padding="0" font-size="14px" line-height="1.6">
                        <p><b>Amount:</b> {AMOUNT} USDT</p>
                        <p><b>Date:</b> {DATE_TIME}</p>
                        <p><b>Wallet Address:</b> {ADDRESS}</p>
                        <p><b>Network Type:</b> {NETWORK}</p>
                        <p><b>Transaction ID:</b> {TRANSACTION_ID}</p>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Support Message -->
            <mj-section padding="16px 0">
                <mj-column>
                    <mj-text css-class="content" padding="0">
                        Your funds should arrive within a few minutes. You may
                        track the status of your transaction anytime from your
                        TraderApp dashboard.
                        <br /><br />
                        If you didn’t initiate this withdrawal or notice any
                        issue, please contact our support team immediately at
                        <a href="mailto:support@traderapp.com"
                            >support@traderapp.com</a
                        >. <br /><br />
                        Thank you for trading with TraderApp. We remain
                        committed to helping you achieve your financial goals.
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Closing -->
            <mj-section padding="0 0 16px 0">
                <mj-column>
                    <mj-text css-class="remark" padding="0">
                        Warm regards,<br />
                        <span class="remarkspan">The TraderApp Team</span>
                    </mj-text>
                </mj-column>
            </mj-section>

            <!-- Social Links -->
            <mj-section css-class="social-box" padding="20px 0">
                <mj-column>
                    <mj-social
                        align="center"
                        mode="horizontal"
                        icon-size="32px"
                        padding="0"
                    >
                        <mj-social-element
                            href="https://x.com/traderapp"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/twitter22.png"
                            alt="Twitter"
                        />
                        <mj-social-element
                            href="https://www.facebook.com/traderappofficial?mibextid=ZbWKwL"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/facebook22.png"
                            alt="Facebook"
                        />
                        <mj-social-element
                            href="https://instagram.com/traderapphq"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/ig22.png"
                            alt="Instagram"
                        />
                        <mj-social-element
                            href="https://traderapp.finance/#"
                            src="https://traderapp-assets.s3.eu-west-1.amazonaws.com/email/tiktok22.png"
                            alt="TikTok"
                        />
                    </mj-social>
                </mj-column>
            </mj-section>
        </mj-wrapper>
    </mj-body>
</mjml>
